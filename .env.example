# ============================================================
# VARIABLES D'ENVIRONNEMENT — ERP PLATFORM
# ============================================================
# Copie ce fichier en .env et adapte les valeurs.
# Le .env réel ne doit JAMAIS être commité.
# ============================================================

# --- PostgreSQL ---
POSTGRES_USER=erp_admin
POSTGRES_PASSWORD=changeme
POSTGRES_DB=erp_platform

# --- DBT ---
DBT_HOST=postgres          
DBT_PORT=5432
DBT_USER=erp_admin
DBT_PASSWORD=changeme
DBT_DBNAME=erp_platform
DBT_SCHEMA=staging

# --- Grafana ---
GRAFANA_PASSWORD=admin

# --- n8n ---
N8N_ENCRYPTION_KEY=ton_secret_ici_min_16_caracteres