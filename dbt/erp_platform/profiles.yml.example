# -----------------------------------------------------------------------
# Exemple de profiles.yml : à copier vers ~/.dbt/profiles.yml (dbt ne lit
# jamais ce fichier depuis le projet lui-même, c'est pour ça qu'il porte
# l'extension .example ici).
#
# Les valeurs par défaut correspondent au PostgreSQL local démarré par
# `docker compose up -d` (voir .env.example à la racine du repo).
# -----------------------------------------------------------------------
erp_platform:
  target: dev
  outputs:
    dev:
      type: postgres
      host: "{{ env_var('POSTGRES_HOST', 'localhost') }}"
      port: "{{ env_var('POSTGRES_PORT', '5432') | as_number }}"
      user: "{{ env_var('POSTGRES_USER', 'postgres') }}"
      password: "{{ env_var('POSTGRES_PASSWORD', 'postgres') }}"
      dbname: "{{ env_var('POSTGRES_DB', 'erp_platform') }}"
      schema: dbt_dev
      threads: 4
